current_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
source $current_dir/../.env
source $current_dir/../utils/helper.sh


export REQUIRED_ENV=""


export MODEL_DIR="$DATA_DIR/stable-diffusion-models"
export REPO_DIR="$ROOT_REPO_DIR/stable-diffusion-comfy"

# Pin ComfyUI to the version running on the working boxes (acc1-4). Unpinned,
# prepare_repo checks out origin/master = bleeding-edge, which hangs at startup
# (asset-DB / "RAM pressure cache") and drags in companion-package/schema
# mismatches. 0.3.45 (2025-07-22) is the known-good commit. Keep in lockstep
# with the torch/xformers pins in main.sh.
export SD_COMFY_UPDATE_REPO="${SD_COMFY_UPDATE_REPO:-commit}"
# [qwen-box] The dedicated Qwen box (acc5, marker written by entry.sh from
# QWEN_DEDICATED_BOX) needs ComfyUI 0.3.62 (qwen_image node type + fp8 unet); SDXL
# boxes (acc1-4) stay on 0.3.45. Both remain overridable by an explicit env. NB: in
# practice prepare_repo does not force-downgrade the persisted /storage repo, so this
# is belt-and-suspenders against a clean reprovision.
if [ -f /notebooks/sd_comfy/.qwen_dedicated_box ]; then
    export SD_COMFY_UPDATE_REPO_COMMIT="${SD_COMFY_UPDATE_REPO_COMMIT:-bab8ba20bf47d985d6b1d73627c2add76bd4e716}"
else
    export SD_COMFY_UPDATE_REPO_COMMIT="${SD_COMFY_UPDATE_REPO_COMMIT:-255f1398638b265a47d0e74fb4759fe6cfc3b3d4}"
fi

export SD_COMFY_PORT="7005"
export EXPOSE_PORTS="$EXPOSE_PORTS:$SD_COMFY_PORT"
export PORT_MAPPING="$PORT_MAPPING:sd_comfy"
export HUGGINGFACE_TOKEN=$HF_TOKEN

export LINK_MODEL_TO=${SD_COMFY_LINK_MODEL_TO:-"${REPO_DIR}/models/checkpoints"}
export LINK_VAE_TO=${SD_COMFY_LINK_VAE_TO:-"${REPO_DIR}/models/vae"}
export LINK_LORA_TO=${SD_COMFY_LINK_LORA_TO:-"${REPO_DIR}/models/loras"}
export LINK_CONTROLNET_TO=${SD_COMFY_LINK_CONTROLNET_TO:-"${REPO_DIR}/models/controlnet"}
export LINK_EMBEDDING_TO=${SD_COMFY_LINK_EMBEDDING_TO:-"${REPO_DIR}/models/embeddings"}
export LINK_UPSCALER_TO=${SD_COMFY_LINK_EMBEDDING_TO:-"${REPO_DIR}/models/upscale_models"}